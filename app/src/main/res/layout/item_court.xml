<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/courtIcon"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:gravity="center"
        android:text="⚽"
        android:textSize="30sp"
        android:background="#DCFCE7" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="13dp">

        <TextView
            android:id="@+id/courtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Lapangan"
            android:textColor="#172B1D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/courtLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Lokasi"
            android:textColor="#5B6B60"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/courtInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="⭐ 4.5 • Hubungi pengelola"
            android:textColor="#15803D"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="#16A34A"
        android:textSize="28sp"
        android:paddingStart="6dp" />

</LinearLayout>